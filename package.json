{
  "name": "kursraum-local",
  "version": "1.0.0",
  "private": true,
  "description": "Lokale, dateibasierte Kursplattform für Desktop",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "preview:desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "test": "node --test tests/*.test.cjs"
  },
  "engines": {"node": ">=20"},
  "dependencies": {
    "chokidar": "^4.0.3",
    "dompurify": "^3.2.3",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "marked": "^15.0.12",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "local.kursraum.desktop",
    "productName": "Kursraum",
    "asar": true,
    "directories": {"output": "release"},
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "mac": {"target": ["dmg", "zip"], "category": "public.app-category.education"},
    "win": {"target": ["nsis"]},
    "linux": {"target": ["AppImage"], "category": "Education"}
  }
}
