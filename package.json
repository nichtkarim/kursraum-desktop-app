{
  "name": "kursraum-local",
  "version": "1.2.0",
  "private": true,
  "description": "Lokale, dateibasierte Kursplattform für Desktop",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "preview:desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "test": "node --test tests/*.test.cjs",
    "dist:deb": "npm run build && electron-builder --linux deb --x64 --publish never",
    "test:video-progress:ui": "npm run build && node tests/ui/video-progress.cjs",
    "test:companion:ui": "npm run build && node tests/ui/companion.cjs",
    "test:cloud:ui": "npm run build && node tests/ui/cloud-video.cjs",
    "test:reflections:ui": "npm run build && node tests/ui/reflections.cjs",
    "test:roadmap:ui": "npm run build && node tests/ui/roadmap.cjs && node tests/ui/roadmap-stability.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.15",
    "@xyflow/react": "^12.12.0",
    "chokidar": "^4.0.3",
    "dompurify": "^3.2.3",
    "electron-store": "^10.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "marked": "^15.0.12",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.58.2",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "local.kursraum.desktop",
    "productName": "Kursraum",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.png"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "build/icons"
    },
    "deb": {
      "packageCategory": "education",
      "synopsis": "Kursbibliothek mit Videoplayer und Nextcloud-Synchronisierung"
    }
  },
  "license": "MIT",
  "homepage": "https://github.com/nichtkarim/kursraum-desktop-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/nichtkarim/kursraum-desktop-app.git"
  },
  "author": {
    "name": "karim",
    "email": "karim.abdulhadi@mail.de"
  }
}
